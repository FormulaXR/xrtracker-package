# Git LFS for native plugins
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text

# macOS bundle. Never touch line endings anywhere inside it: CodeResources
# stores hashes of the other files, so CRLF conversion invalidates the signature.
Plugins/macOS/formula_tracker.bundle/** -text

# The bundle binary has no file extension, so the rules above do not catch it.
Plugins/macOS/formula_tracker.bundle/Contents/MacOS/formula_tracker filter=lfs diff=lfs merge=lfs -text
